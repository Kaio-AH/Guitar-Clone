# Copie para backend/.env e preencha com suas credenciais.
# O backend carrega este arquivo automaticamente.
SPOTIFY_CLIENT_ID=sua_chave_api
SPOTIFY_CLIENT_SECRET=seu_client_secret_id

# Opcional: cookies do YouTube quando o download falhar com HTTP 403
# YT_COOKIES_FILE=C:\caminho\cookies.txt
# YT_COOKIES_BROWSER=chrome
